{
  "name": "putevoy",
  "private": true,
  "version": "1.0.0",
  "description": "Учёт рейсов, расходов ремзоны и оплат",
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Путевой",
  "scripts": {
    "dev": "node --experimental-sqlite --experimental-strip-types server/dev.ts",
    "start": "node --experimental-sqlite --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx src/calc.test.ts && tsx src/cities.test.ts && tsx src/customers.test.ts && tsx src/fleetStatus.test.ts && tsx src/federalRoads.test.ts && tsx src/reports/build.test.ts && tsx src/records.test.ts && tsx src/gibdd.test.ts && node --experimental-sqlite --experimental-strip-types server/db.test.ts && node --experimental-sqlite --experimental-strip-types server/platon.test.ts && node --experimental-sqlite --experimental-strip-types server/auth.test.ts && node --test desktop/proxy.test.cjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:win": "npm run build && electron-builder --win nsis --x64",
    "desktop:mac": "npm run build && electron-builder --mac zip --x64 --arm64"
  },
  "build": {
    "appId": "tech.amvera.putevoy",
    "productName": "Путевой",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Путевой",
      "artifactName": "Putevoy-Setup-${version}.exe",
      "uninstallDisplayName": "Путевой"
    },
    "mac": {
      "icon": "desktop/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "Putevoy-${version}-mac-${arch}.zip"
    }
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
